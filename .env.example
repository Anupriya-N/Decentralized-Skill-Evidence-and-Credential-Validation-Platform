# ==============================================================================
# CertiTrust Platform - Master Environment Template
# Duplicate this file to .env in each corresponding workspace with your secrets.
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://<username>:<password>@localhost:5432/certitrust_db?schema=public"

# Authentication & JWT Secrets (Generate with `openssl rand -hex 64`)
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_char_hex_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Groq Llama-3 AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# File Storage & Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Institutional Private Key Encryption at Rest
INSTITUTION_KEY_ENCRYPTION_SECRET=replace_with_32_byte_aes_gcm_master_secret
DEMO_INSTITUTION_PRIVATE_KEY=0x_sample_institutional_private_key_placeholder

# Blockchain EVM & Relayer Configuration
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=0x_sample_relayer_private_key_placeholder
CONTRACT_ADDRESS=0x_deployed_contract_address_placeholder
CHAIN_ID=31337
