# Frontend Environment Configuration
# NOTICE: API secrets, Gemini API keys, and Ethereum private keys must NEVER be stored in frontend environment variables.
# All blockchain transaction signing and AI model keys reside exclusively in the protected backend service.
VITE_APP_NAME="CertiTrust"
VITE_API_URL=http://localhost:5000/api
VITE_ENABLE_LIVE_BLOCKCHAIN=false
VITE_ENABLE_REAL_AI=false
